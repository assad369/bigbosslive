# Example reverse proxy for the API (TLS terminated here). Socket.IO needs the upgrade headers.
upstream bigboss_api {
  least_conn;
  server 10.0.0.11:3000 max_fails=3 fail_timeout=10s;
  server 10.0.0.12:3000 max_fails=3 fail_timeout=10s;
  keepalive 64;
}

server {
  listen 443 ssl http2;
  server_name api.bigbosslive.app;
  ssl_certificate     /etc/letsencrypt/live/api.bigbosslive.app/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/api.bigbosslive.app/privkey.pem;

  client_max_body_size 1m;

  location /metrics { deny all; }

  location /socket.io/ {
    proxy_pass http://bigboss_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 120s;
  }

  location / {
    proxy_pass http://bigboss_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
