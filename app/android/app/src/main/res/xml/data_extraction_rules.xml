<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or moved to a new device (Android 12+). The per-install device id
     (bb.device_id) must stay on the phone that made it, or device bans could be dodged and a
     restored phone would look like the old one. Sign-in is restored from the server instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
