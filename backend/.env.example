# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (admin dashboard, games).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Trust N proxy hops for client IPs (set to 1 behind a single load balancer).
TRUST_PROXY=1
PUBLIC_BASE_URL=http://localhost:3000

# ── MongoDB (must be a replica set — multi-document transactions are required) ─
MONGODB_URI=mongodb://localhost:27017/bigbosslive?replicaSet=rs0
MONGODB_DB=bigbosslive

# ── Redis (rate limits, Socket.IO adapter, BullMQ jobs) ───────────────────────
REDIS_URL=redis://localhost:6379

# ── Firebase (ID-token verification + FCM) ────────────────────────────────────
FIREBASE_PROJECT_ID=
# Either a path to the service-account JSON or the JSON itself, base64-encoded.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ── LiveKit ────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=21600

# ── Object storage (Cloudflare R2 / S3-compatible) ───────────────────────────
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── In-app purchases ─────────────────────────────────────────────────────
# Google Play: the Firebase service account above needs "View financial data" +
# "Manage orders" in Play Console → Users & permissions.
GOOGLE_PLAY_PACKAGE_NAME=com.bigbosslive.app
# Apple App Store Server API (App Store Connect → Users and Access → Integrations → In-App Purchase).
APPLE_BUNDLE_ID=com.bigbosslive.app
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_BASE64=
APPLE_ENVIRONMENT=production

# ── Jobs ───────────────────────────────────────────────────────────────────
# Set to false on API-only replicas when you run dedicated worker processes.
JOBS_ENABLED=true
# IANA timezone for the monthly host-agency reset.
AGENCY_RESET_TIMEZONE=Asia/Dhaka
