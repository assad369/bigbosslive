# Local development. Production values live in Coolify (docs/COOLIFY.md, "Share links").
NODE_ENV=development
PORT=3100
# The share-link host; must match the app's LINK_HOST (Android manifest, iOS entitlements).
PUBLIC_HOST=links.example.com
# The API as this container reaches it (Docker network), without /v1.
API_INTERNAL_URL=http://localhost:3000
# Same value as the API's LINK_SERVICE_KEY (openssl rand -hex 32).
LINK_SERVICE_KEY=
# Header the edge proxy puts the visitor IP in: x-forwarded-for (Traefik) or cf-connecting-ip (Cloudflare).
CLIENT_IP_HEADER=x-forwarded-for
ANDROID_PACKAGE=com.bigbosslive.bigboss_live
# Comma-separated SHA-256 fingerprints of the release signing key(s): upload key and Play App Signing key.
ANDROID_SHA256_FINGERPRINTS=
# Play listing or APK download page (https). Empty = "coming soon".
ANDROID_STORE_URL=
IOS_BUNDLE_ID=com.bigbosslive.bigbossLive
APPLE_TEAM_ID=
IOS_APP_STORE_ID=
