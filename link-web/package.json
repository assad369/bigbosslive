{
  "name": "link-web",
  "version": "1.0.0",
  "private": true,
  "description": "BigBoss Live share links: App Links / Universal Links verification files and the web page a shared link opens.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.tsx'"
  },
  "dependencies": {
    "@bigboss/shared": "1.0.0",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.12",
    "zod": "^4.1.0"
  }
}
